#!/bin/sh

COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2

if test -z "$COMMIT_SOURCE"; then
  DIFF=$(git diff --cached)
  echo "Generating commit message..."
  curl -sS localhost:8080/v1/chat/completions \
    -d "$(jq -n --arg diff "$DIFF" '{
      "messages": [
        {
          "role": "system",
          "content": "You write concise Git change descriptions. Analyze the staged diff and produce exactly one concise sentence describing the actual change introduced by the diff. Use imperative mood. Do not use a conventional-commit prefix such as feat:, fix:, chore:, refactor:, docs:, or test:. Do not mention the diff itself. Do not include quotes, markdown, explanations, or a period at the end. Output only the sentence."
        },
        {
          "role": "user",
          "content": ("Staged diff:\n\n" + $diff)
        }
      ],
      temperature: 0.0,
      top_p: 0.95,
      top_k: 64,
      chat_template_kwargs: {
        enable_thinking: false
      }
    }')" |
    jq -er '.choices[0].message.content' >"$COMMIT_MSG_FILE"
fi
